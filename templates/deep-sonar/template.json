{
  "schemaVersion": 1,
  "id": "deep-sonar",
  "name": "深海声呐",
  "author": "大肥鱼（AI）· LeeRolling",
  "homepage": "https://github.com/LeeRolling/dsh-boot-suite",
  "license": "MIT",
  "version": "0.6.0",
  "description": "深海军蓝底 + 声呐下潜叙事。和「档案暖白」是完全相反的两条美学路线：一个是纸质档案，一个是深海仪器。",
  "tags": [
    "dark",
    "sonar",
    "terminal",
    "deepsea"
  ],
  "theme": {
    "mode": "dark",
    "bg": "#1b2b38",
    "bg2": "#22384a",
    "ink": "#f4fbff",
    "inkSoft": "#d2e6f2",
    "muted": "#9cb8c9",
    "hair": "rgba(163,214,245,0.30)",
    "hairSoft": "rgba(163,214,245,0.12)",
    "accent": "#5ce1ff",
    "glitchA": "#ff6b85",
    "glitchB": "#5b95ff"
  },
  "steps": [
    {
      "zh": "建立下潜通道",
      "en": "ESTABLISHING DESCENT CHANNEL",
      "say": "Establishing descent channel.",
      "audio": "line-1",
      "log": "正在建立下潜通道…",
      "logEn": "LINKING TO HOST VESSEL",
      "badge": "DESCENT",
      "action": "grant",
      "btnZh": "授权下潜",
      "btnEn": "AUTHORIZE DESCENT",
      "hold": 900
    },
    {
      "zh": "核验操作员",
      "en": "VERIFYING OPERATOR",
      "say": "Verifying operator.",
      "audio": "line-2",
      "log": "核对操作员记录…",
      "logEn": "MATCHING OPERATOR RECORD",
      "badge": "IDENTITY",
      "action": "confirm",
      "btnZh": "确认身份",
      "btnEn": "CONFIRM IDENTITY",
      "hold": 700
    },
    {
      "zh": "声呐校准",
      "en": "SONAR CALIBRATION",
      "say": "Calibrating sonar array.",
      "audio": "line-3",
      "log": "校准换能器阵列…",
      "logEn": "ALIGNING TRANSDUCER ARRAY",
      "badge": "SONAR",
      "action": "auto",
      "hold": 1200,
      "assembleLogo": true
    },
    {
      "zh": "扫描海域",
      "en": "SWEEPING SECTOR",
      "say": "Sweeping sector.",
      "audio": "line-4",
      "log": "扫描当前海域…",
      "logEn": "SWEEPING CURRENT SECTOR",
      "badge": "SWEEP",
      "action": "auto",
      "hold": 1200,
      "hex": true
    },
    {
      "zh": "信号锁定",
      "en": "SIGNAL LOCKED",
      "say": "Signal locked.",
      "audio": "line-5",
      "log": "目标信号已锁定，通道开启",
      "logEn": "TARGET LOCKED · CHANNEL OPEN",
      "badge": "LOCK",
      "action": "auto",
      "hold": 1600,
      "reticle": true
    }
  ],
  "changelog": "0.6.0：底色从近黑（#060b12）提亮到钢蓝（#1b2b38），文字与纱同步提亮 —— 上一版太暗，读起来发闷。"
}
