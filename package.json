{
  "name": "dsh-boot-suite",
  "version": "2.13.20",
  "description": "DeepSeek Harness 启动动画与聊天背景插件：两幕开机动画、自定义动画导入、三段转场、6 套干音音色（英文 1 + 日文 5）+ 5 种声音效果、聊天背景图片/循环视频、更新前自动回滚；聊天背景新增黑白原版素材模式。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek-harness-desktop",
    "startup",
    "splash",
    "boot-animation",
    "wallpaper",
    "background",
    "intro",
    "video"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "templates",
    "tools",
    "test",
    "preview/index.html",
    "open-preview.sh",
    "打开预览.cmd",
    "安装.cmd",
    "cordis.patch.yml",
    "README.md",
    "INSTALL.md",
    "CHANGELOG.md",
    "DESKTOP.md",
    "AUDIO-FIELDS.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/smoke-host.mjs && node test/smoke-splash.mjs && node test/smoke-splash-tl.mjs && node test/smoke-client.mjs && node test/smoke-desktop-boot.mjs && node test/smoke-import.mjs && node test/smoke-wallpaper-host.mjs && node test/smoke-wallpaper-client.mjs && node test/smoke-wallpaper-apply.mjs && node test/smoke-wallpaper-panel.mjs && node test/smoke-merge.mjs && node test/smoke-coords.mjs && node test/smoke-package.mjs",
    "motion:check": "node tools/motion-check.mjs --template=deep-sonar --speed=2",
    "ui:detect": "npx --yes impeccable@latest detect --no-config tools/editor.html preview/index.html",
    "release": "node tools/build-release.mjs"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "author": "沈宏宏 · LeeRolling",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LeeRolling/dsh-boot-suite.git"
  },
  "homepage": "https://github.com/LeeRolling/dsh-boot-suite#readme",
  "bugs": {
    "url": "https://github.com/LeeRolling/dsh-boot-suite/issues"
  }
}
